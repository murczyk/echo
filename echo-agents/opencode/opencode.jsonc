{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "*": "allow",
    "websearch": "deny",
    "webfetch": "deny"
  },

  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM local",
      "options": {
        "baseURL": "http://vllm-host:8000/v1",
        "apiKey": "local"
      },
      "models": {
        "google/gemma-4-26B-A4B-it": {
          "name": "Gemma4-26B-A4B-it (vLLM default)",
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "openai/gpt-oss-120b": {
          "name": "OpenAI GPT-OSS 120B (vLLM alternative)",
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  },

  "model": "vllm/google/gemma-4-26B-A4B-it"
}
