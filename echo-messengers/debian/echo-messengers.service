[Unit]
Description=Echo messengers
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service

[Service]
ExecStart=/usr/bin/echo-messengers
Restart=always
User=root
Group=root
RestartSec=5s
WorkingDirectory=/etc/echo-messengers
StateDirectory=echo-messengers
StateDirectoryMode=0750
Environment=RUST_LOG=info,echo_messengers=debug

[Install]
WantedBy=multi-user.target
