[Unit]
Description=Echo messengers
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/echo-messengers
Restart=always
User=root
Group=root
RestartSec=5s
WorkingDirectory=/etc/echo-messengers
Environment=RUST_LOG=info,echo_messengers=debug

[Install]
WantedBy=multi-user.target
