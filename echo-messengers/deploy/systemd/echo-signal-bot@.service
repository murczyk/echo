[Unit] 
Description=Signal service for %i

[Service] 
ExecStart=/usr/bin/signal-cli-rest-api -signal-cli-config /etc/echo/signal-cli-data/%i/signal-cli/ -attachment-tmp-dir /etc/echo/signal-cli-data/%i/client_data/
Restart=always
User=root
Group=root
RestartSec=5s
EnvironmentFile=/etc/echo/signal-cli-data/%i/%i.env
Environment=MODE=$MODE
Environment=PORT=$PORT

[Install]
WantedBy=multi-user.target

