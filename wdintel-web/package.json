    "@uppy/core": "^4.0.0",
    "@uppy/dashboard": "^4.0.0",
    "@uppy/drag-drop": "^4.0.0",
    "@uppy/file-input": "^4.0.0",
    "@uppy/informer": "^4.0.0",
    "@uppy/progress-bar": "^4.0.0",
    "@uppy/react": "^4.0.0",
    "@uppy/status-bar": "^4.0.0",
    "@uppy/tus": "^4.0.0",
