{
  "name": "wdintel-web",
  "version": "1.0.0",
  "description": "> 🌳  built with [elm-spa](https://elm-spa.dev)",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "rm -rf dist && elm-land build",
    "format:all": "node scripts/format-files.mjs all",
    "format:staged": "node scripts/format-files.mjs staged",
    "postinstall": "node scripts/strip-use-client.mjs",
    "prepare": "git -C .. config core.hooksPath .githooks || true",
    "strip-use-client": "node scripts/strip-use-client.mjs",
    "e2e": "playwright test --grep @smoke",
    "e2e:perf": "playwright test --grep @perf",
    "e2e:install": "playwright install --with-deps chromium",
    "test": "npm run test:prepare && npm run test:elm && npm run test:ts",
    "test:prepare": "elm-land generate",
    "test:elm": "elm-test",
    "test:ts": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
