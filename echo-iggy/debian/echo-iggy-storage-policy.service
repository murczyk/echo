[Unit]
Description=Enforce Iggy storage retention
Requires=echo-iggy.service
After=echo-iggy.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/iggy/root.env
ExecStart=/usr/bin/python3 /usr/local/lib/echo-iggy/storage_policy.py --apply
TimeoutStartSec=10min
UMask=0077
RuntimeDirectory=echo-iggy-storage-policy
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/echo-iggy-storage-policy
StandardOutput=journal
StandardError=journal
