default: ensure-dotenv
    @just --list

ensure-dotenv:
    @if [ ! -f .env ]; then echo "❌ .env file is missing, create it from bitwarden note: Iggy test-cli echo-staging .env" >&2; exit 1; fi

check: ensure-dotenv
    python3 test_iggy.py check

test-inbox: ensure-dotenv
    python3 test_iggy.py test-inbox

test-analytics: ensure-dotenv
    python3 test_iggy.py test-analytics

test-native: ensure-dotenv
    python3 test_iggy.py test-native

test-all: ensure-dotenv
    just check
    just test-inbox
    just test-analytics

send topic: ensure-dotenv
    python3 test_iggy.py send "{{ topic }}"

print-new topic: ensure-dotenv
    python3 test_iggy.py print-new "{{ topic }}"
