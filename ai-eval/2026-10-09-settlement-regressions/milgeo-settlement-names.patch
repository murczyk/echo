+pub fn add_settlement_aliases(result: &mut LocationResult) {
+    let aliases: BTreeMap<String, Vec<SettlementDetails>> =
+        serde_json::from_str(&read_resource("settlement_aliases.json").unwrap())
+            .unwrap();
+    for (region, aliases) in aliases {
+        for alias in aliases {
+            result
+                .entry(region.clone())
+                .or_default()
+                .insert(alias.name.clone(), alias);
+        }
+    }
+}
