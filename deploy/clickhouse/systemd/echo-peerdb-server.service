[Unit]
Description=Echo analytics PeerDB PostgreSQL-wire server
After=network-online.target postgresql@18-main.service echo-peerdb-migrate.service echo-peer-flow-api.service
Wants=network-online.target postgresql@18-main.service echo-peerdb-migrate.service echo-peer-flow-api.service
PartOf=echo-analytics.target
ConditionPathExists=/etc/echo-analytics/peerdb.env

[Service]
Type=simple
User=echo-analytics
Group=echo-analytics
EnvironmentFile=/etc/echo-analytics/instance.env
EnvironmentFile=/etc/echo-analytics/clickhouse.env
EnvironmentFile=/etc/echo-analytics/peerdb.env
ExecStart=/opt/echo-analytics/current/bin/run-peerdb-server.sh serve-no-migrate
WorkingDirectory=/var/lib/echo-analytics
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/echo-analytics /var/log/echo-analytics

[Install]
WantedBy=echo-analytics.target
