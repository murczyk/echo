[Unit]
Description=Echo analytics MinIO staging storage
After=network-online.target
Wants=network-online.target
PartOf=echo-analytics.target
ConditionPathExists=/etc/echo-analytics/peerdb.env

[Service]
Type=simple
User=echo-analytics
Group=echo-analytics
EnvironmentFile=/etc/echo-analytics/instance.env
EnvironmentFile=/etc/echo-analytics/peerdb.env
ExecStart=/opt/echo-analytics/bin/run-minio.sh
WorkingDirectory=/var/lib/echo-analytics
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/echo-analytics/minio

[Install]
WantedBy=echo-analytics.target
