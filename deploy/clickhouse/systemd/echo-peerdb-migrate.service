[Unit]
Description=Echo analytics PeerDB catalog migrations
After=network-online.target postgresql@18-main.service
Wants=network-online.target postgresql@18-main.service
PartOf=echo-analytics.target
ConditionPathExists=/etc/echo-analytics/peerdb.env

[Service]
Type=oneshot
User=echo-analytics
Group=echo-analytics
EnvironmentFile=/etc/echo-analytics/instance.env
EnvironmentFile=/etc/echo-analytics/clickhouse.env
EnvironmentFile=/etc/echo-analytics/peerdb.env
ExecStart=/opt/echo-analytics/current/bin/run-peerdb-server.sh migrate
RemainAfterExit=true
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/echo-analytics

[Install]
WantedBy=echo-analytics.target
