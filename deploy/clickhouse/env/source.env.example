# Installed temporarily or supplied through the environment on the Echo source.
SOURCE_DB=wd
SOURCE_USER=echo_peerdb
SOURCE_PUBLICATION=echo_peerdb_publication
SOURCE_PASSWORD=replace-with-random-value
SOURCE_PG_MAJOR=18
SOURCE_PG_CLUSTER=main
SOURCE_LISTEN_ADDRESS=100.69.44.87
ANALYTICS_ADDRESS=100.104.2.38/32
# Optional override used by deploy/restore-copied-db.sh. By default it derives
# echo@<address> from ANALYTICS_ADDRESS.
ANALYTICS_SSH_TARGET=echo@100.104.2.38

# Retention must be selected from measured WAL/hour and available disk.
SOURCE_MAX_SLOT_WAL_KEEP_SIZE=8GB
SOURCE_IDLE_REPLICATION_SLOT_TIMEOUT=7d
SOURCE_MIN_REPLICATION_SLOTS=10
SOURCE_MIN_WAL_SENDERS=10
WAL_WARN_PERCENT=75
WAL_CRITICAL_PERCENT=90
# Maximum time for deployment to wait for end-to-end analytics health.
ANALYTICS_DEPLOY_HEALTH_TIMEOUT_SECONDS=300
