# Bitwarden note: echo-peerdb-<source-hostname>.
SOURCE_PASSWORD=replace-with-random-value
CATALOG_PASSWORD=replace-with-random-value
TEMPORAL_PASSWORD=replace-with-random-value
GATEWAY_PASSWORD=replace-with-random-value
MINIO_ROOT_PASSWORD=replace-with-random-value
PEERDB_PASSWORD=replace-with-random-value

# Generate the value with: openssl rand -base64 32
PEERDB_CURRENT_ENC_KEY_ID=echo-key-1
PEERDB_ENC_KEYS='[{"id":"echo-key-1","value":"replace-with-32-byte-base64-value"}]'
