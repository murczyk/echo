[Unit]
Description=Reconcile Echo PeerDB table selection
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
Environment=SOURCE_RECONCILE_LOCK_BUSY_IS_SUCCESS=true
ExecStart=/opt/echo-peerdb/current/bin/source-reconcile-if-needed.sh
TimeoutStartSec=7500s
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/echo-peerdb
StateDirectory=echo-peerdb
StateDirectoryMode=0750
