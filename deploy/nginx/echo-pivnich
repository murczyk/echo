server {
    server_name echo-pivnich.hyakutake-chromatic.ts.net pivnich.echoua.info;

    root /usr/share/echo;
    index index.html;
	gzip on;
	gzip_types
		text/css
		text/plain
		text/javascript
		application/javascript
		application/json
		application/x-javascript
		application/xml
		application/xml+rss
		application/xhtml+xml
		application/x-font-ttf
		application/x-font-opentype
		application/vnd.ms-fontobject
		image/svg+xml
		image/x-icon
		application/rss+xml
		application/atom_xml;
    access_log  off;

    client_header_buffer_size 16k;
    large_client_header_buffers 16 64k;
    http2_max_field_size 64k;
    http2_max_header_size 256k;
    client_max_body_size 200M;
    proxy_read_timeout 1200;
    proxy_connect_timeout 1200;
    proxy_send_timeout 1200;

    # PDF.js worker is emitted as .mjs; module scripts require a JavaScript MIME type.
    location ~* \.mjs$ {
        types {
            application/javascript mjs;
        }
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location ^~ /api/sigint/file-upload/ {
        client_max_body_size 2100M;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }
    location /api {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }
    location /api-public {
        proxy_pass http://127.0.0.1:8081/api-public;
        proxy_set_header Host $host;
    }
    location /grafana {
        proxy_pass https://localhost:3000;
        proxy_set_header Host $host;
    }
    location /docs {
        alias /usr/share/echo-docs;
        index index.html;
        try_files $uri $uri/ =404;
        proxy_set_header Host $host;
    }

    listen 80;
    listen [::]:80;

    listen [::]:443 ssl http2; # managed by Certbot
    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /etc/echo/echo.crt;
    ssl_certificate_key /etc/echo/echo.key;
    # include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
