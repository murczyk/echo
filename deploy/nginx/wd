server {
    server_name wildducks.online www.wildducks.online;

    root /fast/kon/www/wd;
    index index.html;
	gzip on;
	gzip_types
		text/css
		text/plain
		text/javascript
		application/javascript
		application/json
		application/x-javascript
		application/xml
		application/xml+rss
		application/xhtml+xml
		application/x-font-ttf
		application/x-font-opentype
		application/vnd.ms-fontobject
		image/svg+xml
		image/x-icon
		application/rss+xml
		application/atom_xml;
    access_log  off;

    client_max_body_size 200M;
    proxy_read_timeout 1200;
    proxy_connect_timeout 1200;
    proxy_send_timeout 1200;

    location / {
        try_files $uri $uri/ /;
        # try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
    location /api {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }
    location /api-public {
        proxy_pass http://127.0.0.1:8081/api-public;
        proxy_set_header Host $host;
    }
    location /docs {
        alias /usr/share/echo-docs;
        index index.html;
        try_files $uri $uri/ =404;
        proxy_set_header Host $host;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/wildducks.online/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/wildducks.online/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.wildducks.online) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = wildducks.online) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;

    server_name wildducks.online www.wildducks.online;
    return 404; # managed by Certbot
}
