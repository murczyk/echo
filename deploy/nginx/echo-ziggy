server {
    server_name echo.local;

    root /home/ziggy/workspace/echo/wdintel-web/dist;
    index index.html;
        gzip on;
        gzip_types
                text/css
                text/plain
                text/javascript
                application/javascript
                application/json
                application/x-javascript
                application/xml
                application/xml+rss
                application/xhtml+xml
                application/x-font-ttf
                application/x-font-opentype
                application/vnd.ms-fontobject
                image/svg+xml
                image/x-icon
                application/rss+xml
                application/atom_xml;

    client_max_body_size 200M;
    proxy_read_timeout 600;
    proxy_connect_timeout 600;
    proxy_send_timeout 600;

    location / {
        proxy_pass http://127.0.0.1:1234;
    }
    ##
    ## Uncomment this if you've built static files with `just build-front` and just want to serve that
    ##
    # location / {
    #     try_files $uri $uri/ /;
    #     # try_files $uri $uri/ =404;
    #     add_header Cache-Control "no-cache";
    # }
    location /api {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }
    location /api-public {
        proxy_pass http://127.0.0.1:8081/api-public;
        proxy_set_header Host $host;
    }
    location /grafana {
        proxy_pass https://127.0.0.1:3000;
        proxy_set_header Host $host;
    }
    location /docs {
        alias /home/ziggy/workspace/echo/docs;
        index index.html;
        try_files $uri $uri/ =404;
        proxy_set_header Host $host;
    }
    location ^~ /api/sigint/file-upload/ {
        client_max_body_size 6200M;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }

    # listen 80;
    # listen [::]:80;

    listen [::]:443 ssl http2; # managed by Certbot
    listen 443 ssl http2; # managed by Certbot

    ssl_certificate /home/ziggy/workspace/echo/deploy/echo.localhost.crt;
    ssl_certificate_key /home/ziggy/workspace/echo/deploy/echo.localhost.key;
}
