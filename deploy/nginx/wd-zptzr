server {
    server_name wildducks.lan www.wildducks.lan zptzr.alpines-banded.ts.net www.zptzr.alpines-banded.ts.net;

    root /home/zptzr/www/wd;
    index index.html;
	gzip on;
	gzip_types
		text/css
		text/plain
		text/javascript
		application/javascript
		application/json
		application/x-javascript
		application/xml
		application/xml+rss
		application/xhtml+xml
		application/x-font-ttf
		application/x-font-opentype
		application/vnd.ms-fontobject
		image/svg+xml
		image/x-icon
		application/rss+xml
		application/atom_xml;
    access_log  off;

    client_max_body_size 200M;
    proxy_read_timeout 1200;
    proxy_connect_timeout 1200;
    proxy_send_timeout 1200;

    location / {
        try_files $uri $uri/ /;
        # try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
    location /api {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }
    location /api-public {
        proxy_pass http://127.0.0.1:8081/api-public;
        proxy_set_header Host $host;
    }
    location /docs {
        alias /usr/share/echo-docs;
        index index.html;
        try_files $uri $uri/ =404;
        proxy_set_header Host $host;
    }

    listen 80;
    listen [::]:80;

    listen [::]:443 ssl http2; # managed by Certbot
    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /home/zptzr/.ssh/zptzr.alpines-banded.ts.net.crt;
    ssl_certificate_key /home/zptzr/.ssh/zptzr.alpines-banded.ts.net.key;
    # include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.zptzr.alpines-banded.ts.net) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = zptzr.alpines-banded.ts.net) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;

    server_name zptzr.alpines-banded.ts.net www.zptzr.alpines-banded.ts.net;
    return 404; # managed by Certbot
}
