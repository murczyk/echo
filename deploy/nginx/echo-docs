server {
    # Core settings
    listen 8331;
    server_name docs.echo;
    root /usr/share/echo-docs;
    index /wdintel_rs/index.html;

    # Logging
    access_log /var/log/nginx/echo-docs.access.log;
    error_log /var/log/nginx/echo-docs.error.log;

    # Performance
    gzip on;
    gzip_static on;
    gzip_types text/plain text/css application/javascript application/json application/wasm;
    gzip_proxied any;
    gzip_min_length 1000;
    gzip_comp_level 6;
    gzip_vary on;

    # Caching for immutable assets
    location ~* \.(?:css|js|wasm|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Error handling
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        internal;
    }
}