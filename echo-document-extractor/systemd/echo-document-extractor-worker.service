[Unit]
Description=Echo Document Extractor worker
After=network-online.target echo-document-extractor.service
Wants=network-online.target

[Service]
Type=simple
User=echo-document-extractor
Group=echo-document-extractor
Environment=ECHO_DOCUMENT_EXTRACTOR_CONFIG=/etc/echo-document-extractor/config.yaml
Environment=PYTHONPATH=/opt/echo-document-extractor/python
Environment=PYTHONNOUSERSITE=1
Environment=HOME=/var/lib/echo-document-extractor
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
Environment=PADDLE_PDX_CACHE_HOME=/var/lib/echo-document-extractor/paddlex-cache
EnvironmentFile=/etc/echo-document-extractor/secret.env
ExecStart=/opt/echo-document-extractor/bin/run-worker
Restart=on-failure
RestartSec=10s
TimeoutStopSec=60s
MemoryMax=13G
TasksMax=4096
UMask=0027

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=false
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/echo-document-extractor
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProcSubset=all
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
