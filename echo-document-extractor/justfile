set dotenv-load := true

target_host := env_var_or_default("TARGET_HOST", "echo-document-extractor")
builder_host := env_var_or_default("BUILDER_HOST", "echo-build-deb13-main")

default:
    @just --list

sync:
    uv sync --extra dev

lock:
    uv lock

lock-check:
    uv lock --check

format:
    uv run ruff format .

lint:
    uv run ruff check .

test:
    uv run pytest -m 'not live'

check: lock-check lint test

package:
    BUILDER_HOST="{{builder_host}}" ./bin/build-on-builder.sh

package-local:
    ./bin/build-packages.sh

package-models:
    ./bin/build-model-package.sh

preflight:
    ./bin/preflight.sh "{{target_host}}"

deploy:
    ./bin/deploy.sh "{{target_host}}"

verify:
    ./bin/verify.sh "{{target_host}}"

verify-clients:
    EXTRACTOR_HOST="{{target_host}}" ./bin/verify-clients.sh

verify-large-job:
    TARGET_HOST="{{target_host}}" ./bin/verify-large-job.sh

rollback:
    TARGET_HOST="{{target_host}}" ./bin/rollback.sh
