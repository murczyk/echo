#!/usr/bin/env bash
set -euo pipefail

ensure_user() {
  local name=$1
  local extra_group=${2:-}
  getent group "$name" >/dev/null || groupadd --system "$name"
  if ! getent passwd "$name" >/dev/null; then
    useradd --system --gid "$name" --home-dir /nonexistent --no-create-home \
      --shell /usr/sbin/nologin "$name"
  fi
  if [[ -n "$extra_group" ]]; then
    usermod --append --groups "$extra_group" "$name"
  fi
}

ensure_user echo-document-extractor
ensure_user echo-document-extractor-otel systemd-journal
install -d -m 0750 -o root -g echo-document-extractor /etc/echo-document-extractor
install -d -m 0750 -o root -g echo-document-extractor-otel \
  /etc/echo-document-extractor-otel
install -d -m 0700 -o echo-document-extractor -g echo-document-extractor \
  /var/lib/echo-document-extractor /var/lib/echo-document-extractor/spool

if [[ ! -f /etc/echo-document-extractor/config.yaml ]]; then
  install -m 0640 -o root -g echo-document-extractor \
    /usr/share/echo-document-extractor/config.yaml \
    /etc/echo-document-extractor/config.yaml
fi
if [[ ! -f /etc/echo-document-extractor/firewall-sources.conf ]]; then
  install -m 0640 -o root -g echo-document-extractor \
    /usr/share/echo-document-extractor/firewall-sources.conf \
    /etc/echo-document-extractor/firewall-sources.conf
fi
if [[ ! -f /etc/echo-document-extractor/secret.env ]]; then
  token=$(openssl rand -base64 48 | tr -d '\n')
  temporary=$(mktemp /etc/echo-document-extractor/.secret.env.XXXXXX)
  chmod 0640 "$temporary"
  chown root:echo-document-extractor "$temporary"
  printf 'ECHO_DOCUMENT_EXTRACTOR_TOKEN=%s\nNUEXTRACT_API_KEY=\nGEMMA_API_KEY=\n' "$token" >"$temporary"
  mv -f "$temporary" /etc/echo-document-extractor/secret.env
fi
install -m 0640 -o root -g echo-document-extractor-otel \
  /usr/share/echo-document-extractor/otel.env \
  /etc/echo-document-extractor-otel/otel.env
install -m 0640 -o root -g echo-document-extractor-otel \
  /usr/share/echo-document-extractor/otel-collector.yaml \
  /etc/echo-document-extractor-otel/otel-collector.yaml

systemctl daemon-reload
systemctl enable echo-document-extractor-firewall.service echo-document-extractor.service \
  echo-document-extractor-worker.service \
  echo-document-extractor-otel.service >/dev/null
