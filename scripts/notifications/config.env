# Discord Notification Configuration (local/dev).
# For CI, set repository secret DISCORD_WEBHOOK_URL_CI and expose it via `env:` in workflows.
DISCORD_WEBHOOK_URL=""

# Notification settings
NOTIFY_CI_TESTS=true
NOTIFY_PR_CHECKS=true
NOTIFY_DEPLOYMENTS=true
NOTIFY_RELEASES=true
NOTIFY_SECURITY=true
NOTIFY_CRITICAL_ISSUES=true

# Only notify for main/master branch workflows
NOTIFY_MAIN_BRANCH_ONLY=true

# Colors (decimal format for Discord embeds)
COLOR_SUCCESS=65280
COLOR_FAILURE=16711680
COLOR_WARNING=16776960
COLOR_INFO=8421504
COLOR_CRITICAL=16711680

# Message limits
MAX_DESCRIPTION_LENGTH=1500
MAX_COMMENT_LENGTH=800
