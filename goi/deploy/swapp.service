[Unit]
Description=swapp service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=echo
WorkingDirectory=/etc/swapp
ExecStart=/etc/swapp/swapp-npm-start.sh
Restart=on-failure
RestartSec=5s
Environment=NODE_ENV=production
Environment=NVM_DIR=/home/echo/.nvm
Environment=PORT=4002
Environment=GOI_APP_DIR=/etc/swapp

[Install]
WantedBy=multi-user.target
