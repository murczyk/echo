set positional-arguments := false

goi_dir := justfile_directory()
repo_dir := goi_dir + "/.."
goi_app_dir := "/etc/goi"
goi_timezone := "Europe/Kyiv"
goi_b2_endpoint_url := "https://s3.eu-central-003.backblazeb2.com"
swapp_dir := justfile_directory()
swapp_app_dir := "/etc/swapp"
swapp_alt_app_dir := "/etc/swapp-alt"
goi_version := "1.3.4"

default:
    @just --list

_require-goi-cloud-access:
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ -z "${AWS_ACCESS_KEY_ID:-}" || -z "${AWS_SECRET_ACCESS_KEY:-}" ]]; then
      echo "❌ AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are required. Look for 'echouastorage-lfs backblaze' in Bitwarden." >&2
      exit 1
    fi

    if ! command -v s5cmd >/dev/null 2>&1; then
      echo "❌ s5cmd is required (https://github.com/peak/s5cmd)" >&2
      exit 1
    fi

goi-sync-from-cloud:
    #!/usr/bin/env bash
    set -euo pipefail

    just _require-goi-cloud-access

    SRC_DIR="{{ goi_dir }}/goi/goi-{{ goi_version }}/"
    ENDPOINT_URL="{{ goi_b2_endpoint_url }}"
    REMOTE_DIR="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/"
    REMOTE_GLOB="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/*"
    LISTING=""

    mkdir -p "${SRC_DIR}"

    LISTING="$(s5cmd --endpoint-url "$ENDPOINT_URL" ls "$REMOTE_GLOB")"
    if [[ -z "${LISTING}" ]]; then
      echo "❌ No GOI {{ goi_version }} release found in Backblaze at ${REMOTE_DIR}" >&2
      exit 1
    fi

    echo "Syncing GOI {{ goi_version }} from Backblaze into ${SRC_DIR}..."
    s5cmd --endpoint-url "$ENDPOINT_URL" sync "$REMOTE_GLOB" "$SRC_DIR"

release:
    #!/usr/bin/env bash
    set -euo pipefail

    just _require-goi-cloud-access

    SRC_DIR="{{ goi_dir }}/goi/goi-{{ goi_version }}/"
    ENDPOINT_URL="{{ goi_b2_endpoint_url }}"
    REMOTE_DIR="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/"

    if [[ ! -d "${SRC_DIR}" ]]; then
      echo "❌ GOI release directory not found: ${SRC_DIR}" >&2
      exit 1
    fi

    echo "Syncing ${SRC_DIR} to ${REMOTE_DIR}..."
    s5cmd --endpoint-url "$ENDPOINT_URL" sync "${SRC_DIR}" "$REMOTE_DIR"

unrelease:
    #!/usr/bin/env bash
    set -euo pipefail

    just _require-goi-cloud-access

    ENDPOINT_URL="{{ goi_b2_endpoint_url }}"
    REMOTE_DIR="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/"
    REMOTE_GLOB="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/*"
    LISTING=""

    LISTING="$(s5cmd --endpoint-url "$ENDPOINT_URL" ls "$REMOTE_GLOB")"
    if [[ -z "${LISTING}" ]]; then
      echo "❌ No GOI {{ goi_version }} release found in Backblaze at ${REMOTE_DIR}" >&2
      exit 1
    fi

    echo "Removing GOI {{ goi_version }} release from ${REMOTE_DIR}..."
    s5cmd --endpoint-url "$ENDPOINT_URL" rm "$REMOTE_GLOB"

[arg('server', long='server')]
setup-dev-container-scripts server:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    REMOTE_HOME="$(ssh "$SERVER" 'printf %s "$HOME"')"
    TARGET_DIR="${REMOTE_HOME}/workspace/goi-container/deploy"
    TARGET_SCRIPT="${TARGET_DIR}/goi-dev-post-clone.sh"
    TARGET_BUNDLE_DIR="${TARGET_DIR}/goi-dev-container"

    echo "Preparing ${SERVER}:${TARGET_DIR}..."
    ssh "$SERVER" "mkdir -p '${TARGET_BUNDLE_DIR}'"

    echo "Uploading GOI post-clone script to ${SERVER}:${TARGET_SCRIPT}..."
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-dev-post-clone.sh" "${SERVER}:${TARGET_SCRIPT}"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-dev-post-clone.sh" "${SERVER}:${TARGET_BUNDLE_DIR}/goi-dev-post-clone.sh"
    ssh "$SERVER" "chmod 0755 '${TARGET_SCRIPT}'"

    echo "Uploading GOI bundle files to ${SERVER}:${TARGET_BUNDLE_DIR}..."
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi.service" "${SERVER}:${TARGET_BUNDLE_DIR}/goi.service"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-npm-start.sh" "${SERVER}:${TARGET_BUNDLE_DIR}/goi-npm-start.sh"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.sh" "${SERVER}:${TARGET_BUNDLE_DIR}/goi-renew-tailscale-cert.sh"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.service" "${SERVER}:${TARGET_BUNDLE_DIR}/goi-renew-tailscale-cert.service"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.timer" "${SERVER}:${TARGET_BUNDLE_DIR}/goi-renew-tailscale-cert.timer"
    ssh "$SERVER" "set -euo pipefail
      chmod 0755 '${TARGET_BUNDLE_DIR}/goi-dev-post-clone.sh' '${TARGET_BUNDLE_DIR}/goi-npm-start.sh' '${TARGET_BUNDLE_DIR}/goi-renew-tailscale-cert.sh'
      chmod 0644 '${TARGET_BUNDLE_DIR}/goi.service' '${TARGET_BUNDLE_DIR}/goi-renew-tailscale-cert.service' '${TARGET_BUNDLE_DIR}/goi-renew-tailscale-cert.timer'
    "

    echo "Done."
    echo "Script path on ${SERVER}: ${TARGET_SCRIPT}"
    echo "Bundle dir on ${SERVER}: ${TARGET_BUNDLE_DIR}"
    echo "Example next step:"
    echo "  incus exec \"\$MACHINE\" -- mkdir -p /var/tmp/goi-dev-container"
    echo "  for f in goi-dev-post-clone.sh goi.service goi-npm-start.sh goi-renew-tailscale-cert.sh goi-renew-tailscale-cert.service goi-renew-tailscale-cert.timer; do incus file push ${TARGET_BUNDLE_DIR}/\$f \"\$MACHINE/var/tmp/goi-dev-container/\$f\"; done"
    echo "  incus exec \"\$MACHINE\" -- /var/tmp/goi-dev-container/goi-dev-post-clone.sh --ts-key \"\$TS_KEY\" --machine \"\$MACHINE\" --domain \"\$DOMAIN\""

[arg('server', long='server')]
setup server:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    APP_DIR="{{ goi_app_dir }}"

    echo "Inspecting current state on ${SERVER}..."
    ssh "$SERVER" 'set -euo pipefail
      echo "host=$(hostname) user=$(whoami)"
      if sudo systemctl list-unit-files goi.service >/dev/null 2>&1; then
        echo "goi.service enabled=$(sudo systemctl is-enabled goi.service 2>/dev/null || true) active=$(sudo systemctl is-active goi.service 2>/dev/null || true)"
      fi
      sudo ls -la /etc/goi || true
      command -v nginx >/dev/null 2>&1 && nginx -v || true
    '

    echo "Installing nvm for user echo (if needed) and setting default Node..."
    ssh "$SERVER" 'set -euo pipefail
      if ! id -u echo >/dev/null 2>&1; then
        echo "user '\''echo'\'' not found" >&2
        exit 1
      fi
      sudo -u echo bash -lc '"'"'
        set -euo pipefail
        export TERM=xterm
        if [[ ! -s "$HOME/.nvm/nvm.sh" ]]; then
          curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash
        fi
        export NVM_DIR="$HOME/.nvm"
        . "$NVM_DIR/nvm.sh"
        nvm install --lts
        nvm alias default "lts/*"
        nvm use --silent default >/dev/null
        node -v
        npm -v
      '"'"'
    '

    echo "Installing nginx..."
    ssh "$SERVER" 'set -euo pipefail
      sudo apt-get update
      sudo DEBIAN_FRONTEND=noninteractive apt-get install -y nginx rsync
    '

    echo "Setting timezone to {{ goi_timezone }}..."
    ssh "$SERVER" "set -euo pipefail
      if ! command -v timedatectl >/dev/null 2>&1; then
        echo 'timedatectl not found; skipping timezone setup' >&2
        exit 0
      fi
      current_timezone=\$(timedatectl show --property=Timezone --value 2>/dev/null || true)
      if [[ \"\$current_timezone\" != '{{ goi_timezone }}' ]]; then
        sudo timedatectl set-timezone '{{ goi_timezone }}'
      fi
      timedatectl show --property=Timezone --value
    "

    echo "Preparing ${APP_DIR}..."
    ssh "$SERVER" "set -euo pipefail
      sudo mkdir -p '${APP_DIR}'
      sudo chown -R echo:echo '${APP_DIR}'
    "

    echo "Syncing goi service files..."
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi.service" "${SERVER}:/etc/systemd/system/goi.service"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-npm-start.sh" "${SERVER}:${APP_DIR}/goi-npm-start.sh"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.sh" "${SERVER}:/usr/local/sbin/goi-renew-tailscale-cert.sh"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.service" "${SERVER}:/etc/systemd/system/goi-renew-tailscale-cert.service"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.timer" "${SERVER}:/etc/systemd/system/goi-renew-tailscale-cert.timer"

    ssh "$SERVER" "set -euo pipefail
      sudo chown root:root /etc/systemd/system/goi.service
      sudo chmod 0644 /etc/systemd/system/goi.service
      sudo chown echo:echo '${APP_DIR}/goi-npm-start.sh'
      sudo chmod 0755 '${APP_DIR}/goi-npm-start.sh'
      sudo chown root:root /usr/local/sbin/goi-renew-tailscale-cert.sh
      sudo chmod 0755 /usr/local/sbin/goi-renew-tailscale-cert.sh
      sudo chown root:root /etc/systemd/system/goi-renew-tailscale-cert.service
      sudo chmod 0644 /etc/systemd/system/goi-renew-tailscale-cert.service
      sudo chown root:root /etc/systemd/system/goi-renew-tailscale-cert.timer
      sudo chmod 0644 /etc/systemd/system/goi-renew-tailscale-cert.timer
      sudo systemctl daemon-reload
      sudo systemctl enable --now goi-renew-tailscale-cert.timer
      sudo systemctl start goi-renew-tailscale-cert.service
      renew_active=\$(sudo systemctl is-active goi-renew-tailscale-cert.service 2>/dev/null || true)
      renew_result=\$(sudo systemctl show goi-renew-tailscale-cert.service -p Result --value 2>/dev/null || true)
      timer_active=\$(sudo systemctl is-active goi-renew-tailscale-cert.timer 2>/dev/null || true)
      echo goi-renew-tailscale-cert.service active=\${renew_active} result=\${renew_result}
      echo goi-renew-tailscale-cert.timer active=\${timer_active}
      sudo systemctl enable goi.service
      goi_enabled=\$(sudo systemctl is-enabled goi.service 2>/dev/null || true)
      goi_active=\$(sudo systemctl is-active goi.service 2>/dev/null || true)
      echo goi.service enabled=\${goi_enabled} active=\${goi_active}
    "

[arg('server', long='server')]
deploy-goi-echo-worker server:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"

    echo "Installing fresh goi-echo-worker on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      sudo apt-get update
      sudo apt-get install -y --reinstall goi-echo-worker
      sudo systemctl enable --now goi-echo-worker
      sudo systemctl restart goi-echo-worker
      sudo systemctl status goi-echo-worker --no-pager
    "

# Like deploy-goi-echo-worker-from but builds local deb and scp it for quick iteration
# Use only on Linux, preferrably 22.04 host
[arg('server', long='server')]
deploy-goi-echo-worker-from-local server:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    DEB_PATH=""
    DEB_NAME=""

    echo "Building local goi-echo-worker deb package..."
    (cd "{{ repo_dir }}" && cargo deb -p goi-echo-worker)

    DEB_PATH="$(ls -1t "{{ repo_dir }}"/target/debian/goi-echo-worker_*_*.deb | head -n 1)"
    if [[ -z "${DEB_PATH}" ]]; then
      echo "❌ Failed to find built goi-echo-worker deb package in target/debian" >&2
      exit 1
    fi
    DEB_NAME="$(basename "${DEB_PATH}")"

    echo "Uploading ${DEB_NAME} to ${SERVER}..."
    scp "${DEB_PATH}" "${SERVER}:/var/tmp/${DEB_NAME}"

    echo "Installing ${DEB_NAME} on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      sudo apt-get update
      cd /var/tmp
      sudo apt install -y --reinstall --allow-downgrades './${DEB_NAME}'
      sudo systemctl enable --now goi-echo-worker
      sudo systemctl restart goi-echo-worker
      sudo systemctl status goi-echo-worker --no-pager
      rm -f './${DEB_NAME}'
    "

[arg('server', long='server')]
deploy server:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    APP_DIR="{{ goi_app_dir }}"
    SRC_DIR="{{ goi_dir }}/goi/goi-{{ goi_version }}/"

    echo "Deploy uses 'just goi-sync-from-cloud' to fetch GOI {{ goi_version }} into ${SRC_DIR} before syncing to ${SERVER}."
    echo "If Backblaze does not have GOI {{ goi_version }} yet, unpack it under ${SRC_DIR}, update goi_version in justfile, and run 'just release' first."
    just goi-sync-from-cloud

    echo "Ensuring ${APP_DIR} exists on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      sudo mkdir -p '${APP_DIR}'
      sudo mkdir -p '${APP_DIR}/data'
      sudo chown -R echo:echo '${APP_DIR}'
    "

    echo "Cleaning stale prebuilt externals in ${APP_DIR}..."
    ssh "$SERVER" "set -euo pipefail
      sudo rm -rf '${APP_DIR}/.next/node_modules'
    "

    echo "Syncing GOI source into ${SERVER}:${APP_DIR}..."
    rsync -az \
      --delete-after \
      --force \
      --exclude '.git/' \
      --exclude '/data/' \
      --exclude '/node_modules/' \
      --exclude '.runtime/' \
      --exclude '.bootstrap/' \
      --exclude '.output/' \
      --exclude 'dist/' \
      --filter 'P goi-npm-start.sh' \
      --filter 'P tailscale.crt' \
      --filter 'P tailscale.key' \
      --exclude '*.log' \
      --exclude 'npm-debug.log*' \
      --exclude 'yarn-debug.log*' \
      --exclude 'yarn-error.log*' \
      --exclude 'pnpm-debug.log*' \
      "${SRC_DIR}" "${SERVER}:${APP_DIR}/"

    echo "Syncing goi service files..."
    scp "{{ goi_dir }}/deploy/goi-npm-start.sh" "${SERVER}:${APP_DIR}/goi-npm-start.sh"
    scp "{{ goi_dir }}/deploy/goi.service" "${SERVER}:/var/tmp/goi.service"
    ssh ${SERVER} 'sudo mv /var/tmp/goi.service /etc/systemd/system/goi.service'

    ssh "$SERVER" "set -euo pipefail
      sudo chown echo:echo '${APP_DIR}/goi-npm-start.sh'
      sudo chmod 0755 '${APP_DIR}/goi-npm-start.sh'
      sudo chown root:root /etc/systemd/system/goi.service
      sudo chmod 0644 /etc/systemd/system/goi.service
    "

    echo "Installing npm dependencies on ${SERVER}..."
    ssh "$SERVER" "sudo -u echo bash -lc '
      set -euo pipefail
      export NVM_DIR=\"\$HOME/.nvm\"
      . \"\$NVM_DIR/nvm.sh\"
      nvm use --silent default >/dev/null
      cd \"${APP_DIR}\"
      if [[ ! -d .next ]]; then
        echo \"missing .next in ${APP_DIR}; this deploy expects prebuilt Next.js artifacts\" >&2
        exit 1
      fi
      if [[ -f package-lock.json ]]; then
        npm ci --no-audit --no-fund
      else
        npm install --no-audit --no-fund
      fi
    '"

    echo "Restarting goi.service on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      sudo systemctl daemon-reload
      sudo systemctl restart goi.service
      sudo systemctl status goi.service --no-pager
    "

    just deploy-goi-echo-worker --server "$SERVER"



