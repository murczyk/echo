[arg('servers', long='servers')]
deploy-many _servers_pos="" servers="":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "{{ _servers_pos }}" != "" ]]; then
      echo "positional servers are not allowed; use: just deploy-many --servers=\"goi-stg goi-prod-01 ...\"" >&2
      exit 1
    fi
    if [[ "{{ servers }}" == "" ]]; then
      echo "missing --servers. usage: just deploy-many --servers=\"goi-stg goi-prod-01 ...\"" >&2
      exit 1
    fi

    if ! command -v echo-install-utils >/dev/null 2>&1; then
      echo "missing echo-install-utils in PATH (install it or deploy it first)" >&2
      exit 1
    fi

    echo-install-utils run-many \
      --values "{{ servers }}" \
      --cwd "{{ goi_dir }}" \
      -- just deploy --server={}

deploy-many-all:
    just deploy-many --servers "{{ goi_servers }}"

deploy-all:
    just deploy-many-all

knowledge-tables-all:
    #!/usr/bin/env bash
    set -euo pipefail

    if ! command -v echo-install-utils >/dev/null 2>&1; then
      echo "missing echo-install-utils in PATH (install it or deploy it first)" >&2
      exit 1
    fi

    echo-install-utils run-many \
      --values "{{ goi_servers }}" \
      --cwd "{{ goi_dir }}" \
      -- ssh {} "sudo -u postgres psql goi -c '\dt+' | grep knowledge"
