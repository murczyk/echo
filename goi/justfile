_require-goi-cloud-access:
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ -z "${AWS_ACCESS_KEY_ID:-}" || -z "${AWS_SECRET_ACCESS_KEY:-}" ]]; then
      echo "❌ AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are required. Look for 'echouastorage-lfs backblaze' in Bitwarden." >&2
      exit 1
    fi

    if ! command -v s5cmd >/dev/null 2>&1; then
      echo "❌ s5cmd is required (https://github.com/peak/s5cmd)" >&2
      exit 1
    fi

goi-sync-from-cloud:
    #!/usr/bin/env bash
    set -euo pipefail

    just _require-goi-cloud-access

    SRC_DIR="{{ goi_dir }}/goi/goi-{{ goi_version }}/"
    ENDPOINT_URL="{{ goi_b2_endpoint_url }}"
    REMOTE_DIR="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/"
    REMOTE_GLOB="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/*"
    LISTING=""

    mkdir -p "${SRC_DIR}"

    LISTING="$(s5cmd --endpoint-url "$ENDPOINT_URL" ls "$REMOTE_GLOB")"
    if [[ -z "${LISTING}" ]]; then
      echo "❌ No GOI {{ goi_version }} release found in Backblaze at ${REMOTE_DIR}" >&2
      exit 1
    fi

    echo "Syncing GOI {{ goi_version }} from Backblaze into ${SRC_DIR}..."
    s5cmd --endpoint-url "$ENDPOINT_URL" sync "$REMOTE_GLOB" "$SRC_DIR"

_verify-goi-node-version-pin:
    #!/usr/bin/env bash
    set -euo pipefail

    PACKAGE_JSON="{{ goi_dir }}/goi/goi-{{ goi_version }}/package.json"
    PINNED_NODE_VERSION="{{ goi_node_version }}"

    if [[ ! -f "${PACKAGE_JSON}" ]]; then
      echo "GOI package.json not found: ${PACKAGE_JSON}" >&2
      echo "Please fetch the GOI release first, then update goi_node_version in justfile, commit, and deploy carefully to test env first." >&2
      exit 1
    fi

    python3 - "${PACKAGE_JSON}" "${PINNED_NODE_VERSION}" <<'PYVERIFY'
    import json
    import re
    import sys

    package_json = sys.argv[1]
    pinned = sys.argv[2]

    with open(package_json, encoding="utf-8") as package_file:
        package = json.load(package_file)

    engine = package.get("engines", {}).get("node")


    def parse_version(version):
        match = re.fullmatch(r"v?(\d+)(?:\.(\d+))?(?:\.(\d+))?", version)
        if not match:
            raise ValueError(f"unsupported version {version!r}")
        return tuple(int(part or 0) for part in match.groups())


    def compare(left, right):
        return (left > right) - (left < right)


    def satisfies_comparator(version, comparator):
        match = re.fullmatch(r"(>=|<=|>|<|=)?v?(\d+(?:\.\d+){0,2})", comparator)
        if not match:
            raise ValueError(f"unsupported comparator {comparator!r}")
        operator = match.group(1) or "="
        required = parse_version(match.group(2))
        compared = compare(version, required)
        return {
            ">=": compared >= 0,
            ">": compared > 0,
            "<=": compared <= 0,
            "<": compared < 0,
            "=": compared == 0,
        }[operator]


    def satisfies_range(version, range_expr):
        for branch in range_expr.split("||"):
            comparators = branch.split()
            if comparators and all(satisfies_comparator(version, comparator) for comparator in comparators):
                return True
        return False


    def fail(reason):
        print("GOI Node version preflight failed.", file=sys.stderr)
        print(f"package.json: {package_json}", file=sys.stderr)
        print(f"engines.node: {engine!r}", file=sys.stderr)
        print(f"justfile goi_node_version: {pinned!r}", file=sys.stderr)
        print(reason, file=sys.stderr)
        print("Please update goi_node_version in justfile, commit, and deploy carefully to test env first.", file=sys.stderr)
        sys.exit(1)


    if not engine:
        fail("package.json does not declare engines.node, so the deploy Node pin cannot be validated.")

    try:
        pinned_version = parse_version(pinned)
        is_valid = satisfies_range(pinned_version, engine)
    except ValueError as err:
        fail(str(err))

    if not is_valid:
        fail("Pinned Node does not satisfy package.json engines.node.")

    print(f"GOI package engines.node {engine!r} accepts pinned Node {pinned}.")
    PYVERIFY

[arg('server', long='server')]
_ensure-goi-node-version server app_dir service fix:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    APP_DIR="{{ app_dir }}"
    SERVICE="{{ service }}"
    FIX="{{ fix }}"
    PINNED_NODE_VERSION="{{ goi_node_version }}"

    echo "Smoke-testing pinned Node ${PINNED_NODE_VERSION} on ${SERVER}..."
    ssh "$SERVER" SERVER="$SERVER" APP_DIR="$APP_DIR" SERVICE="$SERVICE" FIX="$FIX" PINNED_NODE_VERSION="$PINNED_NODE_VERSION" bash -se <<'REMOTE'
    set -euo pipefail

    service_exists() {
      sudo systemctl list-unit-files "${SERVICE}" --no-legend 2>/dev/null | awk '{ print $1 }' | grep -Fxq "${SERVICE}"
    }

    current="$(sudo -u echo bash -lc '
      set -eo pipefail
      export TERM=dumb
      export NVM_DIR="$HOME/.nvm"
      [[ -s "$NVM_DIR/nvm.sh" ]] || exit 2
      . "$NVM_DIR/nvm.sh"
      nvm use --silent default >/dev/null
      printf "%s %s" "$(node -v)" "$(npm -v)"
    ' 2>/dev/null || true)"
    current_node="${current%% *}"
    current_npm="${current#* }"

    if [[ "${current_node}" == "v${PINNED_NODE_VERSION}" && -n "${current_npm}" && "${current_npm}" != "${current_node}" && "${FIX}" != "true" ]]; then
      echo "${SERVER} already uses Node ${current_node} with npm ${current_npm}."
      exit 0
    fi

    if [[ "${FIX}" == "true" ]]; then
      echo "--fix requested; forcing a clean npm dependency rebuild on ${SERVER}."
    else
      echo "${SERVER} has Node ${current_node:-missing}; pinned Node v${PINNED_NODE_VERSION} is required."
    fi
    echo "Pausing ${SERVICE}, upgrading Node, rebuilding npm dependencies, and starting ${SERVICE} again."

    if service_exists; then
      sudo systemctl stop "${SERVICE}" || true
    else
      echo "${SERVICE} is not installed yet; skipping service stop."
    fi

    if [[ -d "${APP_DIR}" ]]; then
      sudo rm -rf "${APP_DIR}/node_modules" "${APP_DIR}/.next/node_modules"
      sudo chown echo:echo "${APP_DIR}"
    fi

    sudo -u echo env APP_DIR="${APP_DIR}" PINNED_NODE_VERSION="${PINNED_NODE_VERSION}" bash -lc '
      set -eo pipefail
      export TERM=dumb
      if [[ ! -s "$HOME/.nvm/nvm.sh" ]]; then
        curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash
      fi
      export NVM_DIR="$HOME/.nvm"
      . "$NVM_DIR/nvm.sh"
      nvm install "$PINNED_NODE_VERSION"
      nvm alias default "$PINNED_NODE_VERSION"
      nvm use --silent default >/dev/null
      node -v
      npm -v

      if [[ ! -f "$APP_DIR/package.json" ]]; then
        echo "$APP_DIR/package.json is absent; skipping dependency rebuild before deploy."
        exit 0
      fi

      cd "$APP_DIR"
      if [[ -f package-lock.json ]]; then
        npm ci --no-audit --no-fund
      else
        npm install --no-audit --no-fund
      fi
    '

    if service_exists; then
      sudo systemctl start "${SERVICE}"
      sudo systemctl status "${SERVICE}" --no-pager
    else
      echo "${SERVICE} is not installed yet; skipping service start."
    fi
    REMOTE

release:
    #!/usr/bin/env bash
    set -euo pipefail

    just _require-goi-cloud-access

    SRC_DIR="{{ goi_dir }}/goi/goi-{{ goi_version }}/"
    ENDPOINT_URL="{{ goi_b2_endpoint_url }}"
    REMOTE_DIR="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/"

    if [[ ! -d "${SRC_DIR}" ]]; then
      echo "❌ GOI release directory not found: ${SRC_DIR}" >&2
      exit 1
    fi

    echo "Syncing ${SRC_DIR} to ${REMOTE_DIR}..."
    s5cmd --endpoint-url "$ENDPOINT_URL" sync "${SRC_DIR}" "$REMOTE_DIR"

unrelease:
    #!/usr/bin/env bash
    set -euo pipefail

    just _require-goi-cloud-access

    ENDPOINT_URL="{{ goi_b2_endpoint_url }}"
    REMOTE_DIR="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/"
    REMOTE_GLOB="s3://echouastorage/lfs/goi/goi-{{ goi_version }}/*"
    LISTING=""

    LISTING="$(s5cmd --endpoint-url "$ENDPOINT_URL" ls "$REMOTE_GLOB")"
    if [[ -z "${LISTING}" ]]; then
      echo "❌ No GOI {{ goi_version }} release found in Backblaze at ${REMOTE_DIR}" >&2
      exit 1
    fi

    echo "Removing GOI {{ goi_version }} release from ${REMOTE_DIR}..."
    s5cmd --endpoint-url "$ENDPOINT_URL" rm "$REMOTE_GLOB"

