set positional-arguments := false

goi_dir := justfile_directory()
goi_app_dir := "/etc/goi"

default:
    @just --list

[arg('server', long='server')]
setup server:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    APP_DIR="{{ goi_app_dir }}"

    echo "Inspecting current state on ${SERVER}..."
    ssh "$SERVER" 'set -euo pipefail
      echo "host=$(hostname) user=$(whoami)"
      sudo systemctl status goi.service --no-pager || true
      sudo ls -la /etc/goi || true
      command -v nginx >/dev/null 2>&1 && nginx -v || true
    '

    echo "Installing nvm for user echo (if needed) and setting default Node..."
    ssh "$SERVER" 'set -euo pipefail
      if ! id -u echo >/dev/null 2>&1; then
        echo "user '\''echo'\'' not found" >&2
        exit 1
      fi
      sudo -u echo bash -lc '"'"'
        set -euo pipefail
        if [[ ! -s "$HOME/.nvm/nvm.sh" ]]; then
          curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash
        fi
        export NVM_DIR="$HOME/.nvm"
        . "$NVM_DIR/nvm.sh"
        nvm install --lts
        nvm alias default "lts/*"
        nvm use --silent default >/dev/null
        node -v
        npm -v
      '"'"'
    '

    echo "Installing nginx..."
    ssh "$SERVER" 'set -euo pipefail
      sudo apt-get update
      sudo DEBIAN_FRONTEND=noninteractive apt-get install -y nginx rsync
    '

    echo "Preparing ${APP_DIR}..."
    ssh "$SERVER" "set -euo pipefail
      sudo mkdir -p '${APP_DIR}'
      sudo chown -R echo:echo '${APP_DIR}'
    "

    echo "Syncing goi service files..."
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi.service" "${SERVER}:/etc/systemd/system/goi.service"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-npm-start.sh" "${SERVER}:${APP_DIR}/goi-npm-start.sh"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.sh" "${SERVER}:/usr/local/sbin/goi-renew-tailscale-cert.sh"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.service" "${SERVER}:/etc/systemd/system/goi-renew-tailscale-cert.service"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.timer" "${SERVER}:/etc/systemd/system/goi-renew-tailscale-cert.timer"

    ssh "$SERVER" "set -euo pipefail
      sudo chown root:root /etc/systemd/system/goi.service
      sudo chmod 0644 /etc/systemd/system/goi.service
      sudo chown echo:echo '${APP_DIR}/goi-npm-start.sh'
      sudo chmod 0755 '${APP_DIR}/goi-npm-start.sh'
      sudo chown root:root /usr/local/sbin/goi-renew-tailscale-cert.sh
      sudo chmod 0755 /usr/local/sbin/goi-renew-tailscale-cert.sh
      sudo chown root:root /etc/systemd/system/goi-renew-tailscale-cert.service
      sudo chmod 0644 /etc/systemd/system/goi-renew-tailscale-cert.service
      sudo chown root:root /etc/systemd/system/goi-renew-tailscale-cert.timer
      sudo chmod 0644 /etc/systemd/system/goi-renew-tailscale-cert.timer
      sudo systemctl daemon-reload
      sudo systemctl enable --now goi-renew-tailscale-cert.timer
      sudo systemctl start goi-renew-tailscale-cert.service
      sudo systemctl status goi-renew-tailscale-cert.service --no-pager || true
      sudo systemctl status goi-renew-tailscale-cert.timer --no-pager || true
      sudo systemctl enable goi.service
      sudo systemctl status goi.service --no-pager || true
    "

[arg('server', long='server')]
deploy server:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    APP_DIR="{{ goi_app_dir }}"
    SRC_DIR="{{ goi_dir }}/goi/goi-1.0.11/"

    echo "Ensuring ${APP_DIR} exists on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      sudo mkdir -p '${APP_DIR}'
      sudo chown -R echo:echo '${APP_DIR}'
    "

    echo "Syncing GOI source into ${SERVER}:${APP_DIR}..."
    rsync -az --delete \
      --exclude '.git/' \
      --exclude '/node_modules/' \
      --exclude '.runtime/' \
      --exclude '.bootstrap/' \
      --exclude '.output/' \
      --exclude 'dist/' \
      --exclude '*.log' \
      --exclude 'npm-debug.log*' \
      --exclude 'yarn-debug.log*' \
      --exclude 'yarn-error.log*' \
      --exclude 'pnpm-debug.log*' \
      "${SRC_DIR}" "${SERVER}:${APP_DIR}/"

    echo "Syncing goi service files..."
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi-npm-start.sh" "${SERVER}:${APP_DIR}/goi-npm-start.sh"
    echo-install-utils ssh-sync-file --take-a "{{ goi_dir }}/deploy/goi.service" "${SERVER}:/etc/systemd/system/goi.service"

    ssh "$SERVER" "set -euo pipefail
      sudo chown echo:echo '${APP_DIR}/goi-npm-start.sh'
      sudo chmod 0755 '${APP_DIR}/goi-npm-start.sh'
      sudo chown root:root /etc/systemd/system/goi.service
      sudo chmod 0644 /etc/systemd/system/goi.service
    "

    echo "Installing npm dependencies on ${SERVER}..."
    ssh "$SERVER" "sudo -u echo bash -lc '
      set -euo pipefail
      export NVM_DIR=\"\$HOME/.nvm\"
      . \"\$NVM_DIR/nvm.sh\"
      nvm use --silent default >/dev/null
      cd \"${APP_DIR}\"
      if [[ ! -d .next ]]; then
        echo \"missing .next in ${APP_DIR}; this deploy expects prebuilt Next.js artifacts\" >&2
        exit 1
      fi
      if [[ -f package-lock.json ]]; then
        npm ci --no-audit --no-fund
      else
        npm install --no-audit --no-fund
      fi
    '"

    echo "Restarting goi.service on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      sudo systemctl daemon-reload
      sudo systemctl restart goi.service
      sudo systemctl status goi.service --no-pager
    "
