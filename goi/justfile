deploy-echo-messengers server builder=goi_builder:
    #!/usr/bin/env bash
    set -euo pipefail

    echo "Ensuring Redis is ready on {{ server }}..."
    ssh "{{ server }}" 'set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      sudo apt-get update
      sudo apt-get install -y redis-server
      sudo systemctl enable --now redis-server
      redis-cli ping | grep -qx PONG
      sudo systemctl status redis-server --no-pager
    '

    # The standalone deploy verifies and deactivates legacy echo-swapp before installation.
    just --justfile "{{ messengers_justfile }}" deploy \
      --server "{{ server }}" \
      --builder "{{ builder }}"

# Like deploy-goi-echo-worker-from but builds local deb and scp it for quick iteration

# Use only on Linux, preferrably 22.04 host
[arg('server', long='server')]
deploy-goi-echo-worker-from-local server:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    DEB_PATH=""
    DEB_NAME=""

    echo "Building local goi-echo-worker deb package..."
    (cd "{{ repo_dir }}" && cargo deb -p goi-echo-worker)

    DEB_PATH="$(ls -1t "{{ repo_dir }}"/target/debian/goi-echo-worker_*_*.deb | head -n 1)"
    if [[ -z "${DEB_PATH}" ]]; then
      echo "❌ Failed to find built goi-echo-worker deb package in target/debian" >&2
      exit 1
    fi
    DEB_NAME="$(basename "${DEB_PATH}")"

    echo "Uploading ${DEB_NAME} to ${SERVER}..."
    scp "${DEB_PATH}" "${SERVER}:/var/tmp/${DEB_NAME}"

    echo "Installing ${DEB_NAME} on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      sudo apt-get update
      cd /var/tmp
      sudo apt install -y --reinstall --allow-downgrades './${DEB_NAME}'
      sudo systemctl enable --now goi-echo-worker
      sudo systemctl restart goi-echo-worker
      sudo systemctl status goi-echo-worker --no-pager
      rm -f './${DEB_NAME}'
    "

[arg('server', long='server')]
_backup-app-data server app_dir:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    APP_DIR="{{ app_dir }}"

    echo "Backing up ${APP_DIR}/data on ${SERVER}..."
    ssh "$SERVER" APP_DIR="$APP_DIR" bash -se <<'REMOTE'
    set -euo pipefail

    if [[ ! -d "${APP_DIR}/data" ]]; then
      echo "${APP_DIR}/data does not exist; skipping backup."
      exit 0
    fi

    BACKUP_DIR="${APP_DIR}/data_bkp/$(date +%d_%m_%y_%H_%M)"
    sudo mkdir -p "${BACKUP_DIR}"
    sudo cp -a "${APP_DIR}/data/." "${BACKUP_DIR}/"
    sudo chown -R echo:echo "${APP_DIR}/data_bkp"
    echo "Backed up ${APP_DIR}/data to ${BACKUP_DIR}"
    REMOTE

[arg('builder', long='builder')]
[arg('fix', long='fix', value='true')]
[arg('server', long='server')]
deploy server builder=goi_builder fix="false":
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    BUILDER="{{ builder }}"
    APP_DIR="{{ goi_app_dir }}"
    SRC_DIR="{{ goi_dir }}/goi/goi-{{ goi_version }}/"

    if [[ "{{ fix }}" != "true" ]]; then
      echo "WARNING: A clean npm dependency rebuild is not forced. Use --fix to pause goi.service, remove node_modules, reinstall dependencies, and start the service again." >&2
    fi

    echo "Deploy uses 'just goi-sync-from-cloud' to fetch GOI {{ goi_version }} into ${SRC_DIR} before syncing to ${SERVER}."
    echo "If Backblaze does not have GOI {{ goi_version }} yet, unpack it under ${SRC_DIR}, update goi_version in justfile, and run 'just release' first."
    just goi-sync-from-cloud
    just --justfile "{{ goi_dir }}/justfile" _verify-goi-node-version-pin

    echo "Ensuring ${APP_DIR} exists on ${SERVER}..."
    ssh "$SERVER" APP_DIR="$APP_DIR" bash -se <<'REMOTE'
    set -euo pipefail

    sudo mkdir -p "${APP_DIR}" "${APP_DIR}/data"
    sudo chown echo:echo "${APP_DIR}" "${APP_DIR}/data"
    REMOTE

    just --justfile "{{ goi_dir }}/justfile" _ensure-goi-node-version --server "$SERVER" "$APP_DIR" goi.service "{{ fix }}"
    just --justfile "{{ goi_dir }}/justfile" _backup-app-data --server "$SERVER" "$APP_DIR"

    echo "Cleaning stale prebuilt externals in ${APP_DIR}..."
    ssh "$SERVER" APP_DIR="$APP_DIR" bash -se <<'REMOTE'
    set -euo pipefail

    if [[ -d "${APP_DIR}/.next/node_modules" ]]; then
      echo "Removing ${APP_DIR}/.next/node_modules (one dot per 1000 paths)..."
      sudo find "${APP_DIR}/.next/node_modules" -depth -print0 \
        | sudo xargs -0 -r -n 1000 sh -c 'rm -rf -- "$@"; printf "." >&2' sh
      echo >&2
    else
      echo "${APP_DIR}/.next/node_modules is already absent."
    fi
    REMOTE

    echo "Ensuring ownership under ${APP_DIR} on ${SERVER}..."
    ssh "$SERVER" APP_DIR="$APP_DIR" bash -se <<'REMOTE'
    set -euo pipefail

    echo "Chowning ${APP_DIR}, excluding node_modules/.runtime/.bootstrap/.output (one dot per 1000 paths)..."
    sudo find "${APP_DIR}" \
      \( -name node_modules -o -name .runtime -o -name .bootstrap -o -name .output \) -prune \
      -o -mindepth 1 -print0 \
      | sudo xargs -0 -r -n 1000 sh -c 'chown echo:echo -- "$@"; printf "." >&2' sh
    echo >&2
    REMOTE

    echo "Syncing GOI source into ${SERVER}:${APP_DIR}..."
    if [[ "$(uname -s)" == "Darwin" ]]; then
      RSYNC_INFO_ARGS=(--progress --stats)
    else
      RSYNC_INFO_ARGS=(--info=flist2,progress2,stats2,name1)
    fi
    rsync -az --human-readable \
      "${RSYNC_INFO_ARGS[@]}" \
      --delete-after \
      --force \
      --exclude '.git/' \
      --exclude '/data_bkp/' \
      --exclude '/data/' \
      --exclude '/node_modules/' \
      --exclude '.runtime/' \
      --exclude '.bootstrap/' \
      --exclude '.output/' \
      --exclude 'dist/' \
      --filter 'P goi-npm-start.sh' \
      --filter 'P tailscale.crt' \
      --filter 'P tailscale.key' \
      --exclude '*.log' \
      --exclude 'npm-debug.log*' \
      --exclude 'yarn-debug.log*' \
      --exclude 'yarn-error.log*' \
      --exclude 'pnpm-debug.log*' \
      "${SRC_DIR}" "${SERVER}:${APP_DIR}/"

    echo "Syncing goi service files..."
    scp "{{ goi_dir }}/deploy/goi-npm-start.sh" "${SERVER}:${APP_DIR}/goi-npm-start.sh"
    just --justfile "{{ goi_dir }}/justfile" _sync-deploy-systemd-units --server "${SERVER}"

    ssh "$SERVER" "set -euo pipefail
      sudo chown echo:echo '${APP_DIR}/goi-npm-start.sh'
      sudo chmod 0755 '${APP_DIR}/goi-npm-start.sh'
    "

    echo "Installing npm dependencies on ${SERVER}..."
    ssh "$SERVER" "sudo -u echo bash -lc '
      set -euo pipefail
      export NVM_DIR=\"\$HOME/.nvm\"
      . \"\$NVM_DIR/nvm.sh\"
      nvm use --silent {{ goi_node_version }} >/dev/null
      cd \"${APP_DIR}\"
      if [[ ! -d .next ]]; then
        echo \"missing .next in ${APP_DIR}; this deploy expects prebuilt Next.js artifacts\" >&2
        exit 1
      fi
      if [[ -f package-lock.json ]]; then
        npm ci --no-audit --no-fund
      else
        npm install --no-audit --no-fund
      fi
    '"

    echo "Restarting goi.service on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      sudo systemctl daemon-reload
      sudo systemctl restart goi.service
      sudo systemctl status goi.service --no-pager
    "

    just deploy-goi-echo-worker --server "$SERVER"
    just deploy-echo-messengers --server "$SERVER" --builder "$BUILDER"
    just update-nginx --server "$SERVER"

[arg('builder', long='builder')]
[arg('server', long='server')]
deploy-first server builder=goi_builder:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"
    BUILDER="{{ builder }}"
    APP_DIR="{{ goi_app_dir }}"
    SRC_DIR="{{ goi_dir }}/goi/goi-{{ goi_version }}/"

    just --justfile "{{ goi_dir }}/justfile" _verify-goi-node-version-pin

    echo "Ensuring ${APP_DIR} exists on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      sudo mkdir -p '${APP_DIR}'
      sudo mkdir -p '${APP_DIR}/data'
      sudo chown -R echo:echo '${APP_DIR}'
    "

    just --justfile "{{ goi_dir }}/justfile" _ensure-goi-node-version --server "$SERVER" "$APP_DIR" goi.service false
    just --justfile "{{ goi_dir }}/justfile" _backup-app-data --server "$SERVER" "$APP_DIR"

    echo "Cleaning stale prebuilt externals in ${APP_DIR}..."
    ssh "$SERVER" "set -euo pipefail
      sudo rm -rf '${APP_DIR}/.next/node_modules'
    "

    echo "Cleaning stale data in ${APP_DIR}..."
    ssh "$SERVER" "set -euo pipefail
      sudo rm -rf '${APP_DIR}/data/*'
    "

    echo "Syncing GOI source into ${SERVER}:${APP_DIR}..."
    rsync -az \
      --delete-after \
      --force \
      --exclude '.git/' \
      --exclude '/data_bkp/' \
      --exclude '/node_modules/' \
      --exclude '.runtime/' \
      --exclude '.bootstrap/' \
      --exclude '.output/' \
      --exclude 'dist/' \
      --filter 'P goi-npm-start.sh' \
      --filter 'P tailscale.crt' \
      --filter 'P tailscale.key' \
      --exclude '*.log' \
      --exclude 'npm-debug.log*' \
      --exclude 'yarn-debug.log*' \
      --exclude 'yarn-error.log*' \
      --exclude 'pnpm-debug.log*' \
      "${SRC_DIR}" "${SERVER}:${APP_DIR}/"

    echo "Syncing goi service files..."
    scp "{{ goi_dir }}/deploy/goi-npm-start.sh" "${SERVER}:${APP_DIR}/goi-npm-start.sh"
    scp "{{ goi_dir }}/deploy/goi.service" "${SERVER}:/var/tmp/goi.service"
    ssh ${SERVER} 'sudo mv /var/tmp/goi.service /etc/systemd/system/goi.service'

    ssh "$SERVER" "set -euo pipefail
      sudo chown echo:echo '${APP_DIR}/goi-npm-start.sh'
      sudo chmod 0755 '${APP_DIR}/goi-npm-start.sh'
      sudo chown root:root /etc/systemd/system/goi.service
      sudo chmod 0644 /etc/systemd/system/goi.service
    "

    echo "Installing npm dependencies on ${SERVER}..."
    ssh "$SERVER" "sudo -u echo bash -lc '
      set -euo pipefail
      export NVM_DIR=\"\$HOME/.nvm\"
      . \"\$NVM_DIR/nvm.sh\"
      nvm use --silent {{ goi_node_version }} >/dev/null
      cd \"${APP_DIR}\"
      if [[ ! -d .next ]]; then
        echo \"missing .next in ${APP_DIR}; this deploy expects prebuilt Next.js artifacts\" >&2
        exit 1
      fi
      if [[ -f package-lock.json ]]; then
        npm ci --no-audit --no-fund
      else
        npm install --no-audit --no-fund
      fi
    '"

    echo "Restarting goi.service on ${SERVER}..."
    ssh "$SERVER" "set -euo pipefail
      sudo systemctl daemon-reload
      sudo systemctl restart goi.service
      sudo systemctl status goi.service --no-pager
    "

    just deploy-goi-echo-worker --server "$SERVER"
    just deploy-echo-messengers --server "$SERVER" --builder "$BUILDER"
    just update-nginx --server "$SERVER"

