_sync-deploy-systemd-units server:
    #!/usr/bin/env bash
    set -euo pipefail

    SERVER="{{ server }}"

    echo "Syncing systemd unit files from deploy/ to ${SERVER}..."
    scp "{{ goi_dir }}/deploy/goi.service" "${SERVER}:/var/tmp/goi.service"
    scp "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.service" "${SERVER}:/var/tmp/goi-renew-tailscale-cert.service"
    scp "{{ goi_dir }}/deploy/goi-renew-tailscale-cert.timer" "${SERVER}:/var/tmp/goi-renew-tailscale-cert.timer"
    scp "{{ goi_dir }}/deploy/swapp.service" "${SERVER}:/var/tmp/swapp.service"
    scp "{{ goi_dir }}/deploy/swapp-alt.service" "${SERVER}:/var/tmp/swapp-alt.service"

    ssh "$SERVER" "set -euo pipefail
      sudo install -o root -g root -m 0644 /var/tmp/goi.service /etc/systemd/system/goi.service
      sudo install -o root -g root -m 0644 /var/tmp/goi-renew-tailscale-cert.service /etc/systemd/system/goi-renew-tailscale-cert.service
      sudo install -o root -g root -m 0644 /var/tmp/goi-renew-tailscale-cert.timer /etc/systemd/system/goi-renew-tailscale-cert.timer
      sudo install -o root -g root -m 0644 /var/tmp/swapp.service /etc/systemd/system/swapp.service
      sudo install -o root -g root -m 0644 /var/tmp/swapp-alt.service /etc/systemd/system/swapp-alt.service
      rm -f /var/tmp/goi.service /var/tmp/goi-renew-tailscale-cert.service /var/tmp/goi-renew-tailscale-cert.timer /var/tmp/swapp.service /var/tmp/swapp-alt.service
      sudo systemctl daemon-reload
    "

