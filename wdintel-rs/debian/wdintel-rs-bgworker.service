[Unit]
Description=echo wdintel-rs background workers
Wants=wdintel-py.service
After=wdintel-py.service

[Service]
ExecStart=/usr/bin/wdintel-rs --mode=live bgworker
Restart=always
User=root
Group=root
RestartSec=5s
TimeoutStopSec=135s
MemoryMax=28G
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/lib
Environment=RUST_LOG=info,wdintel_rs=debug,actix_session=warn
EnvironmentFile=-/etc/echo/ocr.env
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
