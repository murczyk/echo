[Unit]
Description=wdintel-rs background workers

[Service]
ExecStart=/usr/bin/wdintel-rs --mode=live bgworker
Restart=always
User=root
Group=root
RestartSec=5s
MemoryMax=16G
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/lib
Environment=RUST_LOG=info,wdintel_rs=debug,actix_session=warn
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
