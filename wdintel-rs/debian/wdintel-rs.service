[Unit]
Description=wdintel-rs

[Service]
ExecStart=/usr/bin/wdintel-rs --mode=live server
Restart=always
User=root
Group=root
RestartSec=5s
# WorkingDirectory=/home/zptzr/www/wd/dist
# MemoryLimit=8G
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/lib
Environment=RUST_LOG=info,wdintel_rs=debug

[Install]
WantedBy=multi-user.target
