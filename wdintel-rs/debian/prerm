#!/bin/sh
set -e

SERVICE_NAME="wdintel-rs-sigint-worker.service"

# $1 is the argument passed by dpkg/apt. We want to act on upgrade/remove/purge.
if [ "$1" = "upgrade" ] || [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Check if the unit file is still installed (i.e., this is the version
    # that still contains the file, or the upgrade is in process)
    if systemctl status "$SERVICE_NAME" >/dev/null 2>&1; then
        echo "Stopping and disabling retired service: $SERVICE_NAME"
        systemctl stop "$SERVICE_NAME" || true
        systemctl disable "$SERVICE_NAME" || true
    fi
fi

# Always reload the daemon after changes
systemctl daemon-reload || true

exit 0