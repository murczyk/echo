	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"pm.sendRequest({",
					"    url: 'https://{{base_url}}/api/user/login',",
					"    method: 'POST',",
					"    header: {",
					"        'Content-Type': 'application/json'",
					"    },",
					"    body: {",
					"        mode: 'raw',",
					"        raw: JSON.stringify({",
					"            username: '{{login}}',",
					"            password: '{{password}}'",
					"        })",
					"    }",
					"}, function (err, res) {",
					"    if (err) {",
					"        console.error('Login request failed:', err);",
					"        return;",
					"    }",
					"",
					"    // Extract and save cookies from the response",
					"    let cookies = res.headers.filter(h => h.key.toLowerCase() === 'set-cookie');",
					"    if (cookies.length) {",
					"        // Store all cookies or parse and store specific cookie value",
					"        let sessionCookie = cookies.map(c => c.value).join('; ');",
					"        pm.environment.set('sessionCookie', sessionCookie);",
					"    }",
					"});",
					"",
					"if (pm.environment.get('sessionCookie')) {",
					"    pm.request.headers.add({",
					"        key: 'Cookie',",
					"        value: pm.environment.get('sessionCookie')",
					"    });",
					"}"
				]
			}
		},
