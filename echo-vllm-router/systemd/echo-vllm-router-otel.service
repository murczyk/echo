[Unit]
Description=Echo vLLM Router OpenTelemetry collector
Documentation=https://github.com/SigNoz/signoz-otel-collector
After=network-online.target echo-vllm-router.service echo-vllm-router@ocr-gemma.service echo-vllm-router@nuextract.service
Wants=network-online.target echo-vllm-router.service echo-vllm-router@ocr-gemma.service echo-vllm-router@nuextract.service

[Service]
Type=simple
User=echo-vllm-router-otel
Group=echo-vllm-router-otel
EnvironmentFile=/etc/echo-vllm-router/router.env
EnvironmentFile=/etc/echo-vllm-router/router-ocr-gemma.env
EnvironmentFile=/etc/echo-vllm-router/router-nuextract.env
EnvironmentFile=/etc/echo-vllm-router/otel.env
StateDirectory=echo-vllm-router-otel
ExecStart=/opt/echo-vllm-router/bin/signoz-otel-collector --config=/etc/echo-vllm-router/otel-collector.yaml --copy-path=/var/lib/echo-vllm-router-otel/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProcSubset=all
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
