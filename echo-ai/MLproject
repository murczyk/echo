# MLproject
name: ECHO AI
python_env: python_env.yaml

entry_points:
  restore:
    parameters:
      restore_databases: string
    command: "cd /usr/local/echo-ai-train && ./train-download-backups.sh {restore_databases}"
  prepare:
    parameters:
      data_file: path
      prepare_databases: string
    command: "python src/prepare.py -o {data_file} {prepare_databases}"
  scheduled:
    parameters:
      # restore: {type: string, default: "false"}
      # unsupervised: {type: string, default: "false"}
      # restore_databases: {type: string, default: ""}
      databases: { type: string }
    command: "python src/scheduled.py --databases {databases}"
  embeddings:
    parameters:
      data_file: path
    command: "python src/embeddings.py {data_file}"
  supervised:
    parameters:
      data_file: path
      dim: { type: int, default: 100 }
      epoch: { type: int, default: 15 }
      wordNgrams: { type: int, default: 3 }
      autotuneMetric: { type: string, default: "precisionAtRecall:80:__label__1" }
      pretrainedVectors: { type: string, default: "pretrained.vec" }
      autotunePredictions: { type: int, default: 2 }
      autotuneDuration: { type: int, default: 1800 }
      autotuneModelSize: { type: string, default: "128M" }
    command: >-
      python src/supervised.py {data_file} --dim {dim} --epoch {epoch} --wordNgrams {wordNgrams} --pretrainedVectors {pretrainedVectors}
      --autotuneMetric {autotuneMetric} --autotuneDuration {autotuneDuration} --autotuneModelSize {autotuneModelSize} --autotunePredictions {autotunePredictions}
  unsupervised:
    parameters:
      data_file: path
      dim: { type: int, default: 100 }
      epoch: { type: int, default: 20 }
      wordNgrams: { type: int, default: 3 }
    command: >-
      python src/unsupervised.py {data_file} --dim {dim} --epoch {epoch} --wordNgrams {wordNgrams}
