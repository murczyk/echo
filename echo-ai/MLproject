# MLproject
name: ECHO AI
python_env: python_env.yaml

entry_points:
  embeddings:
    parameters:
      data_file: path
    command: "python src/embeddings.py {data_file}"
  unsupervised:
    parameters:
      data_file: path
      args: {type: path, default: "unsupervised.args"}
    command: "python src/unsupervised.py {data_file} @{args}"
