[Unit]
Description=MLflow tracking server

[Service]
ExecStart=%h/.local/bin/mlflow server \
    --host 0.0.0.0 --port 5000 \
    --allowed-hosts "%H.*.ts.net:5000,localhost:5000" \
    --cors-allowed-origins "http://%H.*.ts.net:5000,http://localhost:5000"
WorkingDirectory=%h/echo-ai
EnvironmentFile=%h/echo-ai/.env
Restart=on-failure

[Install]
WantedBy=default.target
