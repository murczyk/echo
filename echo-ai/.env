SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

export UV_PREVIEW_FEATURES=extra-build-dependencies
export MLFLOW_TRACKING_URI=http://127.0.0.1:5000
export MLFLOW_BACKEND_STORE_URI="sqlite:///${SCRIPT_DIR}/mlflow.db"
export MLFLOW_DEFAULT_ARTIFACT_ROOT="${SCRIPT_DIR}/mlruns"
export MLFLOW_SERVE_ARTIFACTS=false
